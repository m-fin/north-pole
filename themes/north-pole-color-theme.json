  "semanticTokenColors": {
    "comment": {
      "foreground": "#8eaa9c",
      "fontStyle": "italic"
    },
    "string": "#5ee0a0",
    "keyword": "#ff6b81",
    "number": "#d9a441",
    "regexp": "#ffb4c0",
    "operator": "#9fb8ac",
    "namespace": "#d5eee4",
    "type": "#7dffc3",
    "struct": "#7dffc3",
    "class": "#7dffc3",
    "interface": "#9fd4e0",
    "enum": "#d9a441",
    "typeParameter": "#f6d98a",
    "function": "#fff4d8",
    "method": "#fff4d8",
    "decorator": "#d9a441",
    "macro": "#ff6b81",
    "variable": "#d5eee4",
    "parameter": "#f6d98a",
    "property": "#a9d4c4",
    "enumMember": "#d9a441",
    "event": "#ffb4c0",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8eaa9c"
      }
    },
    {
      "name": "String",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#5ee0a0"
      }
    },
    {
      "name": "String escape and placeholder",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": {
        "foreground": "#f6d98a"
      }
    },
    {
      "name": "Regular expression",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#ffb4c0"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#d9a441"
      }
    },
    {
      "name": "Language constant",
      "scope": ["constant.language", "support.constant"],
      "settings": {
        "foreground": "#ff6b81"
      }
    },
    {
      "name": "Keyword and storage",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#ff6b81"
      }
    },
    {
      "name": "Operator and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#9fb8ac"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#fff4d8"
      }
    },
    {
      "name": "Type and class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7dffc3"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "support.variable"],
      "settings": {
        "foreground": "#d5eee4"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#f6d98a"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#a9d4c4"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#ff7a8a"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#d9a441"
      }
    },
    {
      "name": "CSS class",
      "scope": ["entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#fff4d8"
      }
    },
    {
      "name": "CSS id",
      "scope": ["entity.other.attribute-name.id"],
      "settings": {
        "foreground": "#7dffc3"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#fff6f7",
        "background": "#b4233a"
      }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "punctuation.definition.heading"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff6b81"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#fff4d8"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f6d98a"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#5ee0a0"
      }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#9fd4e0"
      }
    },
    {
      "name": "Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#5ee0a0"
      }
    },
    {
      "name": "Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#ff6b81"
      }
    },
    {
      "name": "Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#d9a441"
      }
    }
  ]
}
